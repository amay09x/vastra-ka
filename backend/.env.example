# AI & Search Providers
GROQ_API_KEY=your_groq_api_key
SERPER_KEY=your_serper_api_key
SHOPPING_PROVIDER=serper

# Optional Bright Data & Oxylabs
BRIGHTDATA_API_KEY=your_brightdata_api_key
BRIGHTDATA_ZONE=serp_api1
BRIGHTDATA_DATASET_ID=gd_ltppk50q18kdw67omz
OXYLABS_API_KEY=your_oxylabs_api_key

# Azure Blob Storage & Azure SQL
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=vastra-db;Uid=your_admin;Pwd=your_password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Firebase Auth
FIREBASE_PROJECT_ID="vastra-0000"

# Production CORS (set to your Azure Static Web App URL, e.g. https://vastra-app.azurestaticapps.net)
FRONTEND_URL="https://your-frontend.azurestaticapps.net"

